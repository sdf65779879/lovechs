# ====================================================================
# 情侣点餐系统（couple-ordering）环境变量示例
#
# 用法：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 然后执行：docker compose up -d --build
# ====================================================================

# ---- Web 对外访问端口（前端 nginx 映射到宿主机）----
# Linux 服务器通常可直接用 80（访问 http://服务器IP/ 无需带端口）；
# 本机测试若 80 被占用，请改为 8080/8081 等空闲端口
WEB_PORT=80

# ---- MySQL ----
# 数据库名、业务账号与密码；首次启动由 docs/init.sql 自动初始化
MYSQL_DATABASE=couple_ordering
MYSQL_USER=couple
MYSQL_PASSWORD=couple123
MYSQL_ROOT_PASSWORD=couple_root

# ---- JWT 安全密钥（生产环境必须修改！）----
# 要求：长度 >= 32 字节的随机串
# 生成建议：openssl rand -hex 32
# 泄露风险：若密钥泄露，攻击者可伪造登录令牌，请务必更换为随机值
JWT_SECRET=please-change-me-to-a-random-string-at-least-32-bytes-long

# Token 有效期（秒），默认 7 天
JWT_EXPIRE=604800
