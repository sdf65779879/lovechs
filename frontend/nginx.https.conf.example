# ====================================================================
# 情侣点餐系统 · Nginx HTTPS 配置示例（自签证书方案）
#
# 适用场景：局域网 / 内网部署，希望启用 HTTPS（浏览器 Notification
# 依赖 Secure Context：HTTPS 或 localhost）。
#
# 使用步骤：
#   1) 生成自签证书（域名/IP 按实际填写，此处示例 192.168.1.100）：
#        mkdir -p ./certs
#        openssl req -x509 -newkey rsa:2048 -nodes \
#          -keyout ./certs/server.key -out ./certs/server.crt \
#          -days 365 -subj "/CN=192.168.1.100"
#   2) 将本文件复制为 nginx.conf：
#        copy nginx.https.conf.example nginx.conf   (Windows)
#        cp    nginx.https.conf.example nginx.conf  (Linux)
#   3) 修改 docker-compose.yml：把 ./certs 挂载进 frontend 容器，
#      并映射 443 端口：
#        frontend:
#          ports:
#            - "${WEB_PORT:-443}:443"
#          volumes:
#            - ./data/uploads:/app/uploads:ro
#            - ./certs:/etc/nginx/certs:ro
#   4) docker compose up -d --build frontend
#
# 提示：
#   - 自签证书浏览器会提示"不受信任"，需手动信任；仅适合局域网/测试。
#   - 有公网域名时优先用 Caddy 自动申请 Let's Encrypt 证书（见 README）。
# ====================================================================

server {
    listen 443 ssl;
    server_name _;

    # 自签证书（挂载自 ./certs）
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /images/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    location /uploads/ {
        alias /app/uploads/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    location /api/ {
        proxy_pass http://backend:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/xml;
    gzip_vary on;
}
